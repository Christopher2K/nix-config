{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agent-device": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "agent-device@latest",
        "mcp"
      ],
      "enabled": true
    },
    "github": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "omniroute": {
      "type": "remote",
      "url": "https://omniroute.coollab.dev/api/mcp/stream",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MANAGEMENT_KEY}"
      }
    },
    "coolify": {
      "type": "remote",
      "url": "https://hosting.coolsrv.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:COOLIFY_MANAGEMENT_KEY}"
      }
    },
    "doop": {
      "type": "remote",
      "url": "https://doop.coollab.dev/mcp",
      "enabled": true
    }
  },
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.coollab.dev/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "modelID": "opencode-go/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (OpenCode Go)",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "deepseek-v4-pro": {
          "modelID": "opencode-go/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (OpenCode Go)",
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "claude-haiku-5.5-go": {
          "modelID": "opencode-go/claude-haiku-5-5",
          "name": "Claude Haiku 5.5 (OpenCode Go)",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "qwen4-max": {
          "modelID": "opencode-go/qwen4-max",

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agent-device": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "agent-device@latest",
        "mcp"
      ],
      "enabled": true
    },
    "github": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "omniroute": {
      "type": "remote",
      "url": "https://omniroute.coollab.dev/api/mcp/stream",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MANAGEMENT_KEY}"
      }
    },
    "coolify": {
      "type": "remote",
      "url": "https://hosting.coolsrv.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:COOLIFY_MANAGEMENT_KEY}"
      }
    }
  },
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.coollab.dev/v1"
      },
      "models": {
        "coding": {
          "modelID": "coding",
          "name": "Coding (Kimi for Coding → GLM 5.3 Flash → DeepSeek V4.1 Flash)",
          "settings": {
            "reasoningEffort": "medium"
          }
        },
        "deepseek-v4.1-flash": {
          "modelID": "opencode-go/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (OpenCode Go)"
        },
        "deepseek-v4-pro": {
          "modelID": "opencode-go/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (OpenCode Go)"
        },
        "kimi-for-coding": {
          "modelID": "kimi-coding/kimi-for-coding",
          "name": "Kimi for Coding (subscription)"
        },
        "kimi-for-coding-highspeed": {
          "modelID": "kimi-coding/kimi-for-coding-highspeed",
          "name": "Kimi for Coding Highspeed (subscription)"
        },
        "kimi-k3.1-pro-sub": {
          "modelID": "kimi-coding/k3.1-pro",
          "name": "Kimi K3.1 Pro (subscription)"
        },
        "kimi-k3.1-pro-sub-highspeed": {
          "modelID": "kimi-coding/k3.1-pro-highspeed",
          "name": "Kimi K3.1 Pro Highspeed (subscription)"
        },
        "glm-5.3": {
          "modelID": "zai/glm-5.3",
          "name": "GLM 5.3 (Z.ai)"
        },
        "glm-5.3-flash": {
          "modelID": "zai/glm-5.3-flash",
          "name": "GLM 5.3 Flash (Z.ai)"
        },
        "kimi-k3.1-pro": {
          "modelID": "cheaperinference/kimi-k3.1-pro",
          "name": "Kimi K3.1 Pro"
        },
        "kimi-k3.1-pro-highspeed": {
          "modelID": "cheaperinference/kimi-k3.1-pro-highspeed",
          "name": "Kimi K3.1 Pro Highspeed"
        },
        "claude-opus-5.5": {
          "modelID": "cheaperinference/claude-opus-5.5",
          "name": "Claude Opus 5.5"
        },
        "claude-opus-5.5-fast": {
          "modelID": "cheaperinference/claude-opus-5.5-fast",
          "name": "Claude Opus 5.5 Fast"
        }
      }
    },
    "github-copilot": {
      "models": {
        "claude-fable-5": { "disabled": true },
        "claude-fable-5.1": { "disabled": true },
        "claude-haiku-4.5": { "disabled": true },
        "claude-haiku-5.5": { "disabled": true },
        "claude-opus-4.8": { "disabled": true },
        "claude-opus-4.8-fast": { "disabled": true },
        "claude-opus-5": { "disabled": true },
        "claude-opus-5.5": { "disabled": true },
        "claude-sonnet-4.6": { "disabled": true },
        "claude-sonnet-5": { "disabled": true },
        "claude-sonnet-5.5": { "disabled": true },
        "gemini-3.8-flash": { "disabled": true },
        "gemini-4-argon": { "disabled": true },
        "gpt-5.3-codex": { "disabled": true },
        "gpt-5.4-nano": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-5.6-sol": { "disabled": true },
        "gpt-5.6-terra": { "disabled": true },
        "gpt-6-astra": { "disabled": true },
        "gpt-6-luna": { "disabled": true },
        "gpt-6-sol": { "disabled": true },
        "gpt-6.1-sol": { "disabled": true },
        "gpt-6.1-terra": { "disabled": true },
        "grok-4.5": { "disabled": true },
        "grok-4.6": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "kimi-k3": { "disabled": true },
        "mai-code-1.1-flash": { "disabled": true }
      }
    }
  }
}

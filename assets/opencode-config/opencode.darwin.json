{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@bandonker/opencode-finish-guard@1.2.1"
  ],
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"
      ]
    },
    "pencil": {
      "type": "local",
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop"
      ],
      "enabled": true
    }
  }
}

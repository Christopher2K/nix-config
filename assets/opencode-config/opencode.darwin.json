{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@bandonker/opencode-finish-guard@1.2.1"
  ],
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.coollab.dev/v1"
      },
      "models": {
        "coding": {
          "modelID": "coding",
          "name": "Coding (Kimi for Coding → GLM 5.3)"
        },
        "deepseek-v4.1-flash-1017": {
          "modelID": "cheaperinference/deepseek-v4.1-flash-1017",
          "name": "DeepSeek V4.1 Flash 1017"
        },
        "kimi-for-coding": {
          "modelID": "kimi-coding/kimi-for-coding",
          "name": "Kimi for Coding (subscription)"
        },
        "kimi-for-coding-highspeed": {
          "modelID": "kimi-coding/kimi-for-coding-highspeed",
          "name": "Kimi for Coding Highspeed (subscription)"
        },
        "glm-5.3": {
          "modelID": "zai/glm-5.3",
          "name": "GLM 5.3 (Z.ai)"
        },
        "glm-5.3-flash": {
          "modelID": "zai/glm-5.3-flash",
          "name": "GLM 5.3 Flash (Z.ai)"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"
      ]
    },
    "pencil": {
      "type": "local",
      "command": [
        "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
        "--app",
        "desktop"
      ],
      "enabled": true
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://omniroute.coollab.dev/v1"
      },
      "models": {
        "deepseek-v4": {
          "modelID": "deepseek-v4-sub-first",
          "name": "DeepSeek V4 (opencode-go pro → go flash → fallbacks)"
        },
        "deepseek-v4-pro": {
          "modelID": "opencode-go/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro (opencode-go)"
        },
        "deepseek-v4-go-flash": {
          "modelID": "opencode-go/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash (opencode-go)"
        },
        "deepseek-v4.1-flash": {
          "modelID": "cheaperinference/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash"
        },
        "deepseek-v4.1-flash-fast": {
          "modelID": "cheaperinference/deepseek-v4.1-flash-fast",
          "name": "DeepSeek V4.1 Flash Fast"
        },
        "kimi-k3": {
          "modelID": "kimi-coding/k3",
          "name": "Kimi K3 (subscription)"
        },
        "kimi-for-coding": {
          "modelID": "kimi-coding/kimi-for-coding",
          "name": "Kimi for Coding (subscription)"
        },
        "kimi-for-coding-highspeed": {
          "modelID": "kimi-coding/kimi-for-coding-highspeed",
          "name": "Kimi for Coding Highspeed (subscription)"
        },
        "glm-5.3": {
          "modelID": "zai/glm-5.3",
          "name": "GLM 5.3 (Z.ai)"
        },
        "glm-5.3-flash": {
          "modelID": "zai/glm-5.3-flash",
          "name": "GLM 5.3 Flash (Z.ai)"
        },
        "glm-5.2": {
          "modelID": "zai/glm-5.2",
          "name": "GLM 5.2 (Z.ai)"
        },
        "glm-5.1": {
          "modelID": "zai/glm-5.1",
          "name": "GLM 5.1 (Z.ai)"
        },
        "glm-5": {
          "modelID": "zai/glm-5",
          "name": "GLM 5 (Z.ai)"
        },
        "glm-5-turbo": {
          "modelID": "zai/glm-5-turbo",
          "name": "GLM 5 Turbo (Z.ai)"
        },
        "glm-4.7": {
          "modelID": "zai/glm-4.7",
          "name": "GLM 4.7 (Z.ai)"
        },
        "glm-4.7-flash": {
          "modelID": "zai/glm-4.7-flash",
          "name": "GLM 4.7 Flash (Z.ai)"
        },
        "coding": {
          "modelID": "coding",
          "name": "Coding (Kimi K3 → GLM 5.3)"
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"
      ]
    },
    "lucid": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.lucid.app/mcp"]
    },
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "github": {
      "enabled": true ,
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "mobile-mcp": {
      "type": "local",
      "command": [
        "npx",
        "@mobilenext/mobile-mcp@latest"
      ],
      "enabled": false 
    },
    "agent-device": {
      "type": "local",
      "command": [
        "npx",
        "-y", 
        "agent-device@latest",
        "mcp"
      ],
      "enabled": true
    },
    "notion": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "pencil": {
      "type": "local",
      "command": ["/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64", "--app", "desktop"],
      "enabled": true
    },
    "omniroute": {
      "type": "remote",
      "url": "https://omniroute.coollab.dev/api/mcp/stream",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:OMNIROUTE_MANAGEMENT_KEY}"
      }
    }
  }
}

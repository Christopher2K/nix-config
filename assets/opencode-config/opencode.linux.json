{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/etc/profiles/per-user/christopher/bin/helium"
      ]
    },
    "github": {
      "enabled": true,
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}"
      }
    },
    "pencil": {
      "type": "local",
      "command": [
        "@penMcpServer@",
        "--app",
        "desktop"
      ],
      "enabled": true
    },
    "coolify": {
      "type": "remote",
      "url": "https://hosting.coolsrv.dev/mcp",
      "headers": {
        "Authorization": "Bearer {env:COOLIFY_MANAGEMENT_KEY}"
      }
    }
  }
}

  "mcp": {
    "chrome-devtools": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--executable-path=/Applications/Helium.app/Contents/MacOS/Helium"
      ]
    },
    "linear": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.linear.app/mcp"
    },
    "agent-device": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "agent-device@latest",
